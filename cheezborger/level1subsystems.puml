@startuml
title Level 1 Subsystems

legend
    |Color|Type|
    |<#eeee99>|Part of I Can Haz Cheezborger system|
    |<#lightgrey>|External|
end legend

'component "I Can Haz Cheezborger" as core #eeee99 {

    package "Site" as sitePkg #eeee99 {
        [Site Creator] as creator
        () " " as creatorInterface
        creator -up- creatorInterface
        
        [Content Moderation Editor] as moderator
        () " " as moderatorInterface
        moderator -up- moderatorInterface
    }
    
    package "User Management" as userMgmtPkg #eeee99 {
        [User Registry] as users
        () " " as usersInterface
        users -up- usersInterface
    }
    
    package "Content Editing" as contentEditPkg #eeee99 {
        [Content Editor] as contentEdit
        () " " as contentEditInterface
        contentEdit -up- contentEditInterface
        
        [Asset Filer] as assetFiler
        () " " as assetFilerInterface
        assetFiler -up- assetFilerInterface
        
        [External Asset Acquirer] as acquire
        () " " as acquireInterface
        acquire -up- acquireInterface
        
        [Mashup Creator] as mashup
        () " " as mashupInterface
        mashup -up- mashupInterface
    }
    
    package "Analytics" as analyticsPkg #eeee99 {
        [Data Harvester] as harvester
        () " " as harvesterInterface
        harvester -up- harvesterInterface
        
        [Trend Analyzer] as analyzer
        () " " as analyzerInterface
        analyzer -up- analyzerInterface
    }
    
    package "Cross Cutting" as crossCuttingPkg #eeee99 {
        [Permissions Editor] as permission
        () " " as permissionInterface
        permission -up- permissionInterface
        
        note top of permission
            Permissions Editor is used by multiple services
             to determine whether a user has the right to
             perform an action. These are no explicitly 
             called out in the diagram.
        end note
    }
    
'}

component Disqus
cloud "Azure Storage" as siteStorage {
    component "Azure Hosted Meme Site" as site
    database "Assets" as assetData
}
cloud "Web" as generatedMeme {
    [Generated Meme Page Content] as generatedContent
}
cloud "Azure Storage" as storageAnalytics {
    database "Page usage" as pageUsage
}
cloud "Azure Storage" as storage {
    database "Users" as userData
}
cloud "Azure Storage" as storageMod {
    database "Moderation" as moderationData
}
cloud "Azure Storage" as storageAdmin {
    component "Administration Site" as adminUI
    [Generated Admin Page Content] as generatedAdmin
}

assetFiler ..> assetData : writes

adminUI ..> generatedAdmin : generates
generatedAdmin --( creatorInterface
generatedAdmin --( analyzerInterface

analyzer --( harvesterInterface

acquire --( assetFilerInterface

creator ..> site : edits

contentEdit ..> site : edits
contentEdit --( acquireInterface
contentEdit --( mashupInterface

harvester ..> pageUsage : read/write

mashup --( acquireInterface
mashup --( assetFilerInterface

moderator --( contentEditInterface
moderator ..> moderationData : edits

permission ..> userData : read/write

site ..> generatedContent : generates
generatedContent --( contentEditInterface
generatedContent ..> assetData : read
generatedContent --( harvesterInterface
generatedContent ..> Disqus : use
generatedContent --( moderatorInterface
generatedContent --( usersInterface
users ..> userData : read/write
users --( permissionInterface

@enduml
